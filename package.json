{
  "name": "golden-gate-bay-observatory",
  "version": "1.0.0",
  "private": true,
  "description": "An interactive 3D exploration of the Golden Gate Bridge and San Francisco Bay, with animated water, traffic, boats, and coastal fog.",
  "type": "module",
  "license": "MIT",
  "author": "hostlife22",
  "homepage": "https://hostlife22.github.io/js/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hostlife22/js.git"
  },
  "keywords": [
    "golden-gate-bridge",
    "san-francisco",
    "threejs",
    "react-three-fiber",
    "react",
    "typescript",
    "vite",
    "webgl",
    "3d",
    "procedural-generation",
    "visualization"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
